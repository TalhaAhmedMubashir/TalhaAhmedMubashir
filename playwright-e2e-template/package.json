{
  "name": "playwright-e2e-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "codegen": "playwright codegen https://playwright.dev",
    "format": "prettier --write \"{src,tests}/**/*.{ts,js,json,md}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.43.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  }
}
